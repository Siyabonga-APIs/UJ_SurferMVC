@using Microsoft.AspNetCore.Identity
@using UJ_Surfer.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- 5-Minute Inactivity Session Timer -->
        <li class="nav-item me-2">
            <span class="badge bg-light text-secondary border d-flex align-items-center py-2 px-2" title="Session expires in 5 minutes of inactivity">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clock me-1 text-warning" viewBox="0 0 16 16">
                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z" />
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z" />
                </svg>
                <span class="small me-1 text-muted">Session:</span>
                <span id="sessionCountdown" class="fw-bold font-monospace text-dark">05:00</span>
            </span>
        </li>

        
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logoutBtn" type="submit" class="nav-link btn btn-link text-secondary small py-0">Logout</button>
            </form>
        </li>

        <script>
                (function() {
                    const TOTAL_SECONDS = 5 * 60; // 5 minutes
                    let remainingSeconds = TOTAL_SECONDS;
                    const timerDisplay = document.getElementById('sessionCountdown');
                    const logoutForm = document.getElementById('logoutForm');

                    function updateDisplay() {
                        const minutes = Math.floor(remainingSeconds / 60);
                        const seconds = remainingSeconds % 60;

                        const formattedMin = String(minutes).padStart(2, '0');
                        const formattedSec = String(seconds).padStart(2, '0');

                        timerDisplay.textContent = `${formattedMin}:${formattedSec}`;

                        // Change badge styling to danger under 1 minute remaining
                        if (remainingSeconds <= 60) {
                            timerDisplay.classList.remove('text-dark');
                            timerDisplay.classList.add('text-danger');
                        } else {
                            timerDisplay.classList.remove('text-danger');
                            timerDisplay.classList.add('text-dark');
                        }
                    }

                    // Decrement every second
                    const timerInterval = setInterval(function() {
                        remainingSeconds--;
                        if (remainingSeconds <= 0) {
                            clearInterval(timerInterval);
                            timerDisplay.textContent = "00:00";
                            // Automatically submit logout when session expires
                            if (logoutForm) {
                                logoutForm.submit();
                            }
                        } else {
                            updateDisplay();
                        }
                    }, 1000);

                    // Optional: reset timer on user mouse/key interaction to match sliding expiration
                    const resetEvents = ['mousedown', 'keydown', 'scroll', 'touchstart'];
                    resetEvents.forEach(function(eventName) {
                        window.addEventListener(eventName, function() {
                            remainingSeconds = TOTAL_SECONDS;
                            updateDisplay();
                        }, { passive: true });
                    });

                    updateDisplay();
                })();
        </script>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>