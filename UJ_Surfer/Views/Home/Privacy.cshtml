@{
    ViewData["Title"] = "Privacy Policy & Disclaimer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="mb-4 pb-2 border-bottom">
                <h1 class="h3 fw-bold text-dark">Privacy Policy & Institutional Disclaimer</h1>
                <p class="text-muted small mb-0">Last updated: October 2026 | Governing South African Law (POPIA Compliant)</p>
            </div>

            <!-- SECTION 1: INSTITUTIONAL DISCLAIMER -->
            <div class="card border-0 bg-light p-4 mb-4 border-start border-4 border-warning shadow-sm">
                <h5 class="fw-bold text-dark mb-2">1. University Non-Affiliation & Disclaimer of Responsibility</h5>
                <p class="small text-secondary mb-2">
                    <strong>UJ Surfer is an independent academic exploration platform.</strong> It is not owned by, managed by, formally affiliated with, or endorsed by the <strong>University of Johannesburg (UJ)</strong>.
                </p>
                <p class="small text-secondary mb-2">
                    All academic information, admission point score (APS) calculations, qualification codes, minimum subject requirements, and faculty details are derived directly from the publicly accessible <em>University of Johannesburg 2027 Undergraduate Prospectus</em>.
                </p>
                <p class="small text-secondary mb-0">
                    <strong>No Guarantee of Admission:</strong> Fulfilling the minimum requirements calculated by this system does not ensure acceptance into any academic programme, as final selections are subject to institutional capacity, faculty board discretion, and official Department of Higher Education and Training (DHET) quota approvals. UJ Surfer accepts no liability for decisions made based on the results provided by this tool, nor for any subsequent amendments made by the university to its entrance criteria.
                </p>
            </div>

            <!-- SECTION 2: INFORMATION WE COLLECT -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark">2. Information We Collect (POPIA Notice)</h5>
                <p class="text-secondary small">
                    In compliance with the <em>Protection of Personal Information Act 4 of 2013 (POPIA)</em>, we only collect the minimum personal data necessary to provide you with your qualification eligibility records:
                </p>
                <ul class="text-secondary small ps-3">
                    <li><strong>Account Credentials:</strong> Your email address and securely hashed password used solely for authentication and session management.</li>
                    <li><strong>Academic Record Data:</strong> Self-reported National Senior Certificate (NSC) percentages, subject choices, and your resulting Admission Point Score (APS).</li>
                </ul>
            </div>

            <!-- SECTION 3: HOW YOUR DATA IS USED -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark">3. How Your Information Is Used</h5>
                <p class="text-secondary small">
                    Your information is strictly utilized to:
                </p>
                <ul class="text-secondary small ps-3">
                    <li>Maintain your persistent profile so you do not have to re-enter your marks on subsequent visits.</li>
                    <li>Match your scores against database records of university faculty and programme entry criteria.</li>
                    <li>Provide a customized list of eligible undergraduate degree and diploma pathways.</li>
                </ul>
                <p class="text-secondary small">
                    We do <strong>not</strong> sell, rent, disclose, or distribute your personal or academic information to third parties or marketing brokers.
                </p>
            </div>

            <!-- SECTION 4: DATA STORAGE & SESSION SECURITY -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark">4. Data Storage, Sessions & Security</h5>
                <ul class="text-secondary small ps-3">
                    <li><strong>Security:</strong> All user passwords are encrypted using industry-standard ASP.NET Core Identity PBKDF2 hashing algorithms.</li>
                    <li><strong>Inactivity Timeout:</strong> For your privacy, user sessions automatically expire after <strong>5 minutes of inactivity</strong>, requiring re-authentication to access your saved records.</li>
                    <li><strong>Data Erasure:</strong> You retain the right to update your marks or request account removal at any time through the platform interface.</li>
                </ul>
            </div>

            <!-- SECTION 5: OFFICIAL CONTACT -->
            <div class="p-3 bg-white border rounded">
                <h6 class="fw-bold text-dark mb-1">Official University Enquiries</h6>
                <p class="text-secondary small mb-0">
                    To submit an official application or verify current enrolment details, please consult the official University of Johannesburg portal at <a href="https://www.uj.ac.za" target="_blank" class="text-decoration-none">www.uj.ac.za</a>.
                </p>
            </div>

        </div>
    </div>
</div>